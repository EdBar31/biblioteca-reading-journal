@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Nunito+Sans:wght@400;600;700&display=swap');

:root {
  --lila: #8B6BBE;
  --lila-oscuro: #62458F;
  --lila-suave: #E9DDF5;
  --lavanda-claro: #F6F1FA;
  --crema: #FBF9F4;
  --blanco: #FFFFFF;
  --texto: #332F38;
  --texto-secundario: #77717D;
  --borde: #E4DDE8;
  --sombra: 0 4px 20px rgba(98, 69, 143, 0.08);
  --radio: 18px;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--crema);
  color: var(--texto);
  font-family: 'Nunito Sans', sans-serif;
  -webkit-tap-highlight-color: transparent;
}

body {
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  max-width: 560px;
  margin: 0 auto;
  position: relative;
}

h1, h2, h3, .display {
  font-family: 'Cormorant Garamond', serif;
  color: var(--texto);
  margin: 0;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

input, select, textarea {
  font-family: inherit;
  font-size: 1rem;
  color: var(--texto);
  background: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: 12px;
  padding: 10px 14px;
  width: 100%;
}

input:focus, select:focus, textarea:focus, button:focus-visible {
  outline: 2px solid var(--lila);
  outline-offset: 1px;
}

/* Fondo botánico sutil */
.leaf-bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.05;
  background-image:
    radial-gradient(circle at 15% 20%, var(--lila) 0, transparent 40%),
    radial-gradient(circle at 85% 80%, var(--lila-oscuro) 0, transparent 40%);
  z-index: 0;
}

/* Header */
.app-header {
  padding: 28px 20px 14px;
  position: relative;
  z-index: 1;
}
.app-header .eyebrow {
  color: var(--texto-secundario);
  font-size: 0.85rem;
}
.app-header h1 {
  font-size: 1.9rem;
  font-weight: 600;
}

/* Views */
.view {
  flex: 1;
  padding: 0 20px 100px;
  position: relative;
  z-index: 1;
}
.view[hidden] { display: none; }

/* Cards */
.card {
  background: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  box-shadow: var(--sombra);
  padding: 18px;
  margin-bottom: 16px;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 16px;
}
.summary-item {
  background: var(--lavanda-claro);
  border-radius: 14px;
  padding: 14px 8px;
  text-align: center;
}
.summary-item .num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.6rem;
  color: var(--lila-oscuro);
  font-weight: 600;
  display: block;
}
.summary-item .label {
  font-size: 0.72rem;
  color: var(--texto-secundario);
}

/* Now reading card */
.reading-cover {
  width: 56px;
  height: 80px;
  border-radius: 6px;
  background: var(--lila-suave);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--lila-oscuro);
  font-size: 1.4rem;
  overflow: hidden;
}
.reading-cover img { width: 100%; height: 100%; object-fit: cover; }

.row { display: flex; gap: 14px; align-items: center; }
.grow { flex: 1; min-width: 0; }

.progress-bar {
  height: 8px;
  border-radius: 8px;
  background: var(--lila-suave);
  overflow: hidden;
  margin: 8px 0;
}
.progress-bar > div {
  height: 100%;
  background: var(--lila);
  border-radius: 8px;
  transition: width 0.3s ease;
}

.btn {
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
  font-size: 0.92rem;
  text-align: center;
}
.btn-primary { background: var(--lila); color: var(--blanco); }
.btn-secondary { background: var(--lila-suave); color: var(--lila-oscuro); }
.btn-ghost { background: transparent; color: var(--lila-oscuro); border: 1px solid var(--borde); }
.btn-block { width: 100%; display: block; }
.btn-row { display: flex; gap: 10px; }
.btn-row .btn { flex: 1; }

.streak {
  color: var(--lila-oscuro);
  font-weight: 700;
}

/* Library grid */
.filters {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 4px;
  margin-bottom: 14px;
  scrollbar-width: none;
}
.filters::-webkit-scrollbar { display: none; }
.filter-chip {
  white-space: nowrap;
  padding: 7px 14px;
  border-radius: 20px;
  background: var(--blanco);
  border: 1px solid var(--borde);
  font-size: 0.85rem;
  color: var(--texto-secundario);
}
.filter-chip.active {
  background: var(--lila);
  color: var(--blanco);
  border-color: var(--lila);
}

.search-box { margin-bottom: 14px; }

.book-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.book-tile {
  cursor: pointer;
  text-align: left;
}
.book-tile .cover {
  width: 100%;
  aspect-ratio: 2/3;
  border-radius: 10px;
  background: var(--lila-suave);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--lila-oscuro);
  font-size: 1.6rem;
  overflow: hidden;
  margin-bottom: 6px;
  position: relative;
}
.book-tile .cover img { width: 100%; height: 100%; object-fit: cover; }
.book-tile .status-dot {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--lila);
}
.book-tile .title {
  font-size: 0.82rem;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 1px;
}
.book-tile .author {
  font-size: 0.72rem;
  color: var(--texto-secundario);
}
.book-tile .pct {
  font-size: 0.72rem;
  color: var(--lila-oscuro);
  font-weight: 700;
}

.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: var(--texto-secundario);
}
.empty-state .icon { font-size: 2.4rem; margin-bottom: 10px; }

/* Bottom nav */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 560px;
  background: var(--blanco);
  border-top: 1px solid var(--borde);
  display: flex;
  padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
  z-index: 10;
}
.nav-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 6px 2px;
  color: var(--texto-secundario);
  font-size: 0.68rem;
  border-radius: 10px;
}
.nav-btn .icon { font-size: 1.25rem; }
.nav-btn.active { color: var(--lila-oscuro); }

/* Floating add button */
.fab {
  position: fixed;
  bottom: 88px;
  right: calc(50% - 260px + 16px);
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: var(--lila);
  color: var(--blanco);
  font-size: 1.6rem;
  box-shadow: 0 6px 18px rgba(98, 69, 143, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9;
}
@media (max-width: 592px) {
  .fab { right: 16px; }
}

/* Modal / sheet */
.sheet-overlay {
  position: fixed;
  inset: 0;
  background: rgba(51, 47, 56, 0.35);
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.sheet-overlay[hidden] { display: none; }
.sheet {
  background: var(--crema);
  width: 100%;
  max-width: 560px;
  max-height: 92vh;
  overflow-y: auto;
  border-radius: 24px 24px 0 0;
  padding: 20px 20px calc(24px + env(safe-area-inset-bottom));
}
.sheet-handle {
  width: 40px;
  height: 4px;
  background: var(--borde);
  border-radius: 4px;
  margin: 0 auto 16px;
}
.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
.close-x { font-size: 1.3rem; color: var(--texto-secundario); padding: 4px 8px; }

.field { margin-bottom: 14px; }
.field label {
  display: block;
  font-size: 0.8rem;
  color: var(--texto-secundario);
  margin-bottom: 5px;
  font-weight: 600;
}
.field-row { display: flex; gap: 10px; }
.field-row .field { flex: 1; }

.chip-select { display: flex; gap: 8px; flex-wrap: wrap; }
.chip-select .chip {
  padding: 8px 14px;
  border-radius: 20px;
  border: 1px solid var(--borde);
  background: var(--blanco);
  font-size: 0.85rem;
  color: var(--texto-secundario);
}
.chip-select .chip.selected {
  background: var(--lila);
  border-color: var(--lila);
  color: var(--blanco);
}

.stars { display: flex; gap: 6px; font-size: 1.6rem; }
.stars .star { color: var(--borde); }
.stars .star.filled { color: var(--lila); }

.cover-upload {
  width: 90px;
  height: 128px;
  border-radius: 10px;
  background: var(--lila-suave);
  border: 1px dashed var(--lila);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--lila-oscuro);
  font-size: 1.6rem;
  overflow: hidden;
  cursor: pointer;
  margin: 0 auto 14px;
}
.cover-upload img { width: 100%; height: 100%; object-fit: cover; }

/* Pomodoro */
.timer-wrap {
  text-align: center;
  padding: 30px 10px 10px;
}
.timer-circle {
  width: 220px;
  height: 220px;
  border-radius: 50%;
  margin: 0 auto 22px;
  background: var(--lavanda-claro);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.timer-circle svg { position: absolute; inset: 0; }
.timer-time {
  font-family: 'Cormorant Garamond', serif;
  font-size: 3rem;
  color: var(--lila-oscuro);
  font-weight: 600;
  z-index: 1;
}
.timer-label {
  color: var(--texto-secundario);
  font-size: 0.85rem;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 6px;
}
.timer-book { margin-bottom: 22px; }
.timer-book .t { font-weight: 700; }
.timer-book .a { color: var(--texto-secundario); font-size: 0.85rem; }

.mood-select { display: flex; justify-content: space-between; gap: 6px; }
.mood-select button {
  font-size: 1.7rem;
  flex: 1;
  padding: 10px 0;
  border-radius: 12px;
  background: var(--blanco);
  border: 1px solid var(--borde);
}
.mood-select button.selected { background: var(--lila-suave); border-color: var(--lila); }

/* Journal entries */
.journal-entry {
  border-left: 3px solid var(--lila-suave);
  padding-left: 12px;
  margin-bottom: 16px;
}
.journal-entry .meta {
  font-size: 0.72rem;
  color: var(--texto-secundario);
  margin-bottom: 4px;
}
.journal-entry .type-badge {
  display: inline-block;
  background: var(--lila-suave);
  color: var(--lila-oscuro);
  font-size: 0.68rem;
  padding: 2px 8px;
  border-radius: 10px;
  margin-right: 6px;
  font-weight: 700;
}
.journal-entry blockquote {
  margin: 0;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 1.15rem;
  color: var(--texto);
}

/* Stats */
.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid var(--borde);
  font-size: 0.9rem;
}
.stat-row:last-child { border-bottom: none; }
.stat-row .v { font-weight: 700; color: var(--lila-oscuro); }

.bar-chart { display: flex; align-items: flex-end; gap: 6px; height: 90px; margin-top: 10px; }
.bar-chart .bar {
  flex: 1;
  background: var(--lila-suave);
  border-radius: 4px 4px 0 0;
  position: relative;
  min-height: 4px;
}
.bar-chart .bar .fill {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: var(--lila);
  border-radius: 4px 4px 0 0;
}
.bar-chart .bar .lbl {
  position: absolute;
  bottom: -18px;
  left: 0; right: 0;
  text-align: center;
  font-size: 0.62rem;
  color: var(--texto-secundario);
}

.section-title {
  font-size: 1.15rem;
  margin-bottom: 10px;
  margin-top: 4px;
}

.toast {
  position: fixed;
  bottom: 90px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: var(--lila-oscuro);
  color: var(--blanco);
  padding: 10px 18px;
  border-radius: 20px;
  font-size: 0.85rem;
  opacity: 0;
  transition: all 0.25s ease;
  pointer-events: none;
  z-index: 50;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

.linkline {
  color: var(--lila-oscuro);
  font-weight: 700;
  font-size: 0.88rem;
}
